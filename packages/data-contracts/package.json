{
  "name": "@topostack/data-contracts",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Data-layer contracts shared by the browser, the map-api Worker, and the provisioning scripts: catalog validation, archive release parsing, terrain PNG decoding, and usage events. Source-only; every consumer compiles TypeScript itself.",
  "exports": {
    "./archive-release": "./src/archive-release.ts",
    "./source-catalog": "./src/source-catalog.ts",
    "./terrain-png": "./src/terrain-png.ts",
    "./usage": "./src/usage.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "coverage": "vitest run src --coverage --coverage.reportsDirectory=coverage --coverage.thresholds.statements=90 --coverage.thresholds.branches=80 --coverage.thresholds.functions=90 --coverage.thresholds.lines=90"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "sideEffects": false
}
